// Windows Application Resource Definition
// 1 is IDI_APPLICATION icon for Windows Explorer and Taskbar
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Sound Card Test Waveform Generator"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "sound-signal-generator"
            VALUE "OriginalFilename", "sound-signal-generator.exe"
            VALUE "ProductName", "Sound Card Test Waveform Generator"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
